<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> KARDEMİR Araç Kontrol Merkezi </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/webp" href="~/images/logo.webp" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.webp" alt="Kardemir" height="35" class="me-2" />
                    <span class="fw-bold fs-5 tracking-tight text-dark">Araç Kontrol Merkezi</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="visitorLogs" asp-action="Index">Araçları Görüntüle</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="visitorLogs" asp-action="Create">Araç Ekle</a>
                            </li>
                            
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link fw-bold" asp-controller="Personel" asp-action="Ekle">
                                             Personel Ekle
                                        </a>
                                    </li>
                                   <li class="nav-item">
                                        <a class="nav-link fw-bold" asp-controller="Yonetici" asp-action="OnayBekleyenler">
                                             Onay Bekleyen Talepler
                                        </a>
									</li>
                                    <li class="nav-item">
                                        <a class="nav-link fw-bold" asp-area="" asp-controller="Reports" asp-action="Index">Raporlama</a>
                                    </li>
                                }
                            }
                        </ul>


                        <div class="d-flex align-items-center gap-3">

                            <div class="text-end d-none d-md-block">
                                <span class="d-block fw-bold text-dark" style="font-size: 14px;">
                                    @User.Claims.FirstOrDefault(c => c.Type == "AdSoyad")?.Value
                                </span>
                                <small class="text-success fw-bold" style="font-size: 11px;">Aktif</small>
                            </div>

                            <a asp-controller="Giris" asp-action="CikisYap" class="btn btn-outline-danger fw-bold shadow-sm px-4 rounded-2">
                                <i class="bi bi-box-arrow-right me-1"></i> ÇIKIŞ YAP
                            </a>

                        </div>
                    </div>
                }
            </div>

        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Akıllı Çözümler Müdürlüğü - <a asp-area="" asp-controller="Home" asp-action="Privacy">KVKK</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>