@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container mt-5">
    <div class="row mb-5">
        <div class="col-12">
            <div class="p-4 bg-light border border-light-subtle rounded-3 d-flex justify-content-between align-items-center shadow-sm">

                <div class="d-flex align-items-center">
                    <img src="~/images/logo.webp" alt="Kardemir Logo" height="50" class="me-3" />
                    <div>
                        <h3 class="fw-black text-dark m-0 tracking-tight">KARDEMİR</h3>
                        <small class="text-muted text-uppercase tracking-wider font-monospace" style="font-size: 11px;">Operasyon Kontrol Merkezi</small>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a href="/visitorLogs/Create" class="btn btn-dark btn-sm fw-bold px-4 py-2 rounded-2 shadow-sm d-flex align-items-center">
                        + Yeni Araç Girişi
                    </a>
                 
                </div>

            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3" style="background-color: #e7f1ff !important;">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold text-uppercase" style="font-size: 11px; color: #052c65;">İçerideki Toplam</span>
                            <span class="p-2 bg-white rounded-circle small shadow-sm" style="color: #0d6efd;">⏱</span>
                        </div>
                        <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #052c65;">@ViewBag.ToplamIcerideki</h2>
                    </div>
                    <div class="mt-4 pt-3" style="border-top: 1px solid rgba(5, 44, 101, 0.1);">
                        <a href="/visitorLogs/Index" class="text-decoration-none small fw-bold" style="color: #052c65;">Canlı Listeyi Gör &rarr;</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3" style="background-color: #e1f5fe !important;">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold text-uppercase" style="font-size: 11px; color: #0a5c36;">Güvenli Durum</span>
                            <span class="p-2 bg-white rounded-circle small shadow-sm" style="color: #198754;">✓</span>
                        </div>
                        <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #0a5c36;">@ViewBag.KurallaraUygun</h2>
                    </div>
                    <div class="mt-4 pt-3" style="border-top: 1px solid rgba(10, 92, 54, 0.1);">
                        <a href="/visitorLogs/Index" class="text-decoration-none small fw-bold" style="color: #0a5c36;">Detayları İncele &rarr;</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3" style="background-color: #f8d7da !important;">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold text-uppercase" style="font-size: 11px; color: #842029;">Kritik Aşım</span>
                            <span class="p-2 bg-white rounded-circle small shadow-sm" style="color: #dc3545;">⚠️</span>
                        </div>
                        <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #842029;">@ViewBag.AsimYapanlar</h2>
                    </div>
                    <div class="mt-4 pt-3" style="border-top: 1px solid rgba(132, 32, 41, 0.1);">
                        <a href="/visitorLogs/Index" class="text-decoration-none small fw-bold" style="color: #842029;">Müdahale Et &rarr;</a>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>