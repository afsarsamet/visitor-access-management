@model List<WebApplication1.Models.FirmaTalep>

<div class="container mt-4">
    <h2 class="mb-4 text-dark">Onay Bekleyen Firma Talepleri</h2>
    <hr />

    <table class="table table-hover table-bordered mt-3 shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Firma Adı</th>
                <th>Talep Tarihi</th>
                <th>Talep Eden Personel Sicil No</th>
                <th>Talep Eden Personel Ad Soyad</th>
                <th class="text-center" style="width: 200px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
           
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        <em>Şu an onay bekleyen herhangi bir firma talebi bulunmuyor.</em>
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr id="talep-@item.Id">
                        <td class="align-middle fw-bold">@item.FirmaAdi</td>
                        <td class="align-middle">@item.TalepTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="align-middle">@item.TalepEdenSicilNo</td>
                        <td class="align-middle">@item.TalepEdenAdSoyad</td>
                        <td class="text-center">
                            <button onclick="onayla(@item.Id)" class="btn btn-sm btn-success w-100 mb-1">
                                Onayla
                            </button>
                            <button onclick="reddet(@item.Id)" class="btn btn-sm btn-danger w-100">
                                Reddet
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        
        function onayla(id) {
            $.post('/Yonetici/TalebiOnayla', { id: id }, function(res) {
                if(res.success) {
                   
                    $('#talep-' + id).fadeOut('slow', function() {
                        $(this).remove();
                        kontrolEt(); 
                    });
                }
            }).fail(function() {
                alert("Onaylama sırasında bir hata oluştu! Sunucu bağlantısını kontrol edin.");
            });
        }

        
        function reddet(id) {
            if(confirm("Bu talebi reddetmek istediğinize emin misiniz?")) {
                $.post('/Yonetici/TalebiReddet', { id: id }, function(res) {
                    if(res.success) {
                        $('#talep-' + id).fadeOut('slow', function() {
                            $(this).remove();
                            kontrolEt();
                        });
                    }
                }).fail(function() {
                    alert("Silme sırasında bir hata oluştu!");
                });
            }
        }

        
        function kontrolEt() {
            if ($('tbody tr').length === 0) {
                $('tbody').append('<tr><td colspan="5" class="text-center text-muted py-4"><em>Tüm talepler işlendi. Bekleyen talep yok.</em></td></tr>');
            }
        }
    </script>
}